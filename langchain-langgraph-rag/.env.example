# Copy to .env (git-ignored) and fill in. Loaded by env-cmd via the pnpm scripts;
# a variable already set in your shell takes precedence over this file.
# Leave optional values commented out: an empty value counts as "set".

# --- Storage (defaults: src/docs, src/docs.db) ---
# DOCS_DIR=
# DB_PATH=

# --- OCR agent: any OpenAI-compatible endpoint serving Unlimited-OCR ---
OCR_ENABLED=true
OCR_BASE_URL=http://localhost:8000/v1
OCR_MODEL=baidu/Unlimited-OCR
# OCR_PROMPT=document parsing.
# OCR_API_KEY=
# OCR_TIMEOUT_MS=300000

# --- Layout-aware PDF extraction (tables stay tables, columns stay in order) ---
# A Python parser run as a subprocess. Create its environment once with: pnpm layout:setup
# docling (MIT licence, recommended) or pymupdf (AGPL licence). Unset = plain text layer (unpdf).
# PDF_LAYOUT_ENGINE=docling
# PDF_LAYOUT_PYTHON=.venv-layout/bin/python
# PDF_LAYOUT_TIMEOUT_MS=600000

# --- PDF page router: a page goes to OCR when any threshold trips ---
PDF_MIN_CHARS=50
PDF_MAX_MATH_RATIO=0.02
# PDF_RENDER_SCALE=2
# Opt-in: also OCR pages where images cover at least this fraction of the page
# (for corpora with text inside images, such as infographics). Unset by default:
# a page with a usable text layer is read from the text however many images it has.
# PDF_OCR_IMAGE_COVERAGE=0.5

# --- Retrieval relevance gate: calibrate with `pnpm eval:retrieval <golden.json>` ---
# Cross-encoder reranker. bge-reranker-base is larger (slower) but reads tables and
# paraphrases better than the MiniLM default; recalibrate the two settings below after changing it.
# RERANK_MODEL=Xenova/bge-reranker-base
# RERANK_MIN_SCORE=0
# RERANK_MARGIN=3
# Chat second-stage rerank by the chat model. Questions the gate rejects whose best score
# is below RERANK_REJECT_BELOW are refused without a model call. Unset = no floor, so
# every rejected question costs one model call. Calibrate: pnpm eval:retrieval <golden.json> --target 0.99
# RERANK_REJECT_BELOW=
# CHAT_RERANK_CANDIDATES=8
# Retry once with alternative search queries when nothing helpful was found (default true).
# Each retry costs extra model calls, but only for questions that would be refused otherwise.
# CHAT_QUERY_REWRITE=true
# How questions are answered: "auto" (default: comparisons go to the agent, the rest to the cheaper
# pipeline), "agent" (the chat model calls the MCP document tools itself and can search again with other
# wording) or "pipeline" (fixed retrieve/rerank/answer).
# CHAT_RETRIEVAL=auto
# Measure both with `pnpm eval:chat` and your model before choosing: with a local 9B model
# "pipeline" passed 10/10 at ~19k tokens and "agent" 9/10 at ~52k (see SCALING.md).
# Agent budgets per question: model turns, and total tool calls.
# CHAT_MAX_ROUNDS=5
# CHAT_MAX_TOOL_CALLS=6

# --- Document router LLM fallback (only for ambiguous or unmatched files) ---
# Any OpenAI-compatible endpoint. Both BASE_URL and MODEL must be set to enable it.
# Example, local LM Studio (needs its API token; reasoning models need a longer timeout):
#   ROUTER_BASE_URL=http://localhost:1234/v1
#   ROUTER_MODEL=<model id shown in LM Studio>
#   ROUTER_API_KEY=<LM Studio API token>
#   ROUTER_TIMEOUT_MS=180000
# Check the setup with: pnpm router:check <file>
# ROUTER_BASE_URL=
# ROUTER_MODEL=
# ROUTER_API_KEY=
# ROUTER_TIMEOUT_MS=60000

# --- Chat API (pnpm api) ---
# API_PORT=3001
# CHAT_RATE_LIMIT_PER_MIN=30
# CHAT_MAX_SOURCES=5
# Small chat model behind any OpenAI-compatible endpoint. Both BASE_URL and MODEL
# must be set; otherwise the API returns cited excerpts instead of composed answers.
# Example, local LM Studio (needs its API token; reasoning models need a longer timeout):
#   CHAT_BASE_URL=http://localhost:1234/v1
#   CHAT_MODEL=<model id shown in LM Studio>
#   CHAT_API_KEY=<LM Studio API token>
#   CHAT_TIMEOUT_MS=180000
# CHAT_BASE_URL=
# CHAT_MODEL=
# CHAT_API_KEY=
# CHAT_TIMEOUT_MS=60000
# Only set these if your model accepts them (some small/reasoning models reject them).
# 0 makes answers repeatable, which regression runs (pnpm eval:chat) rely on:
# CHAT_TEMPERATURE=0
# CHAT_MAX_TOKENS=

# Logging: JSON lines (OpenTelemetry log data model) to stderr and to a timestamped
# file in logs/ (one file per process start, per service).
# LOG_LEVEL=info          debug | info | warn | error | silent
# LOG_DIR=                default <project>/logs; set empty to disable the file
# LOG_STDERR=true         false = file only
# LOG_FORMAT=json         pretty = readable console lines (the file stays JSON)
# LOG_QUERIES=false       true = also log the search query text (off by default: privacy)
# OTEL_SERVICE_NAME=      overrides the service name (docs-rag-api, docs-rag-ingest, docs-rag-mcp)
