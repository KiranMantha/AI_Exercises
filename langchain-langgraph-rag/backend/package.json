{
  "name": "docs-rag-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "env-cmd --no-override -f ../.env npx @modelcontextprotocol/inspector node src/server.js",
    "ingest": "env-cmd --no-override -f ../.env node src/ingest.js",
    "ingest:full": "env-cmd --no-override -f ../.env node src/ingest.js --force",
    "test": "env-cmd --no-override -f ../.env node src/test-client.js",
    "test:unit": "node --test \"src/**/*.test.js\"",
    "api": "env-cmd --no-override -f ../.env node src/api.js",
    "web:dev": "env-cmd --no-override -f ../.env pnpm --dir ../web dev",
    "dev": "concurrently --kill-others-on-fail -n api,web -c blue,green \"pnpm api\" \"pnpm web:dev\"",
    "router:check": "env-cmd --no-override -f ../.env node src/ingestion/checkRouter.js",
    "eval:retrieval": "env-cmd --no-override -f ../.env node src/eval/evaluateRetrieval.js",
    "eval:chat": "env-cmd --no-override -f ../.env node src/eval/chatRegression.js",
    "layout:setup": "uv venv .venv-layout --python 3.12 && uv pip install --python .venv-layout/bin/python docling"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@langchain/langgraph": "^1.5.2",
    "@langchain/textsplitters": "^1.0.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/canvas": "^1.0.13",
    "better-sqlite3": "^13.0.3",
    "sqlite-vec": "^0.1.9",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "onnxruntime-node",
      "protobufjs"
    ]
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "env-cmd": "^11.0.0"
  }
}
