{
  "name": "langchain-langgraph-rag",
  "version": "1.0.0",
  "private": true,
  "description": "Document RAG: backend/ (ingestion, search, MCP server, chat API) and web/ (Preact chat UI). These scripts forward to them.",
  "scripts": {
    "start": "pnpm --dir backend start",
    "ingest": "pnpm --dir backend ingest",
    "ingest:full": "pnpm --dir backend ingest:full",
    "test": "pnpm --dir backend test",
    "test:unit": "pnpm --dir backend test:unit",
    "api": "pnpm --dir backend api",
    "dev": "pnpm --dir backend dev",
    "router:check": "pnpm --dir backend router:check",
    "eval:retrieval": "pnpm --dir backend eval:retrieval",
    "eval:chat": "pnpm --dir backend eval:chat",
    "layout:setup": "pnpm --dir backend layout:setup",
    "backend:install": "pnpm --dir backend install",
    "web:install": "pnpm --dir web install",
    "web:dev": "pnpm --dir backend web:dev",
    "web:build": "pnpm --dir web build",
    "web:test": "pnpm --dir web test"
  }
}
